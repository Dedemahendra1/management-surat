flowchart TD
    A(["Mulai"]) --> B{"Pengguna: role pimpinan?"}
    B -- "Bukan pimpinan" --> C["Server action tolak:<br/>'Hanya pimpinan yang dapat menyetujui'"]
    C --> D(["Selesai: error"])
    B -- "Pimpinan" --> E["Klik Setujui<br/>(dropdown atau dialog detail)"]
    E --> F["Server action approveSuratKeluar"]
    F --> G{Status = dibuat?}
